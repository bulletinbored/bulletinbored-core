# Deny script execution inside user uploads. Files here are served as static
# assets only. The core already restricts uploads to image MIMEs via
# validate_uploaded_file(), but this is defence in depth so a malicious or
# mis-named file can never be executed even if written here.
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phar|cgi|pl|py|rb|asp|aspx|jsp)$">
    Require all denied
</FilesMatch>
