<IfModule mod_rewrite.c>
    RewriteEngine On

    # The rewrite rules below are relative (no RewriteBase) so they work
    # regardless of the install path: /forum, /forum-nuovo or document root.
    RewriteRule ^thread/([0-9]+)(?:-([^/]+))?$ index.php?action=thread&id=$1 [L,QSA]
    RewriteRule ^category/([0-9]+)(?:-([^/]+))?$ index.php?action=category&id=$1 [L,QSA]
    RewriteRule ^u/([^/]+)$ index.php?action=profile&user=$1 [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>
