<?xml version="1.0" encoding="UTF-8"?>
<!--
    bulletinbored — IIS web.config

    This file provides URL Rewrite rules equivalent to the Apache .htaccess
    and nginx.conf configurations. Place it in the root of your bulletinbored
    installation.

    Requires the IIS URL Rewrite Module (https://www.iis.net/downloads/microsoft/url-rewrite)
-->
<configuration>
    <system.webServer>
        <defaultDocument>
            <files>
                <clear />
                <add value="index.php" />
            </files>
        </defaultDocument>

        <rewrite>
            <rules>
                <!-- Block direct access to secrets and CLI/dev entrypoints -->
                <rule name="bulletinbored-block-sensitive-files" stopProcessing="true">
                    <match url="^(config\.json|config\.php|bb\.php|router\.php)$" />
                    <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Direct access to this file is not allowed" />
                </rule>

                <!-- Block direct access to private uploads -->
                <rule name="bulletinbored-block-private-uploads" stopProcessing="true">
                    <match url="^uploads/private(?:/|$)" />
                    <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Direct access to private uploads is not allowed" />
                </rule>

                <!-- Front controller: route everything through index.php.
                     The PHP router handles all path matching. -->
                <rule name="bulletinbored-front-controller" stopProcessing="true">
                    <match url="^(.*)$" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="index.php" appendQueryString="true" />
                </rule>
            </rules>
        </rewrite>

        <!-- Block access to sensitive directories (but NOT the entire uploads segment) -->
        <security>
            <requestFiltering>
                <hiddenSegments>
                    <add segment="data" />
                </hiddenSegments>
                <denyUrlSequences>
                    <add sequence=".htaccess" />
                    <add sequence=".user.ini" />
                </denyUrlSequences>
            </requestFiltering>
        </security>

        <!-- Static file caching -->
        <staticContent>
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
        </staticContent>
    </system.webServer>
</configuration>
